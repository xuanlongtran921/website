        sub: (currentLang === 'vi') ? 'Đã tải 512 lượt • Tự động tính ROI & dòng tiền' : ((currentLang === 'zh') ? '已下载 512 次 • 自动化收益看板' : '512 downloads • Multi-network commission forecast formulas'),
