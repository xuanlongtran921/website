        sub: (currentLang === 'vi') ? 'Đã bán 428 bản • Tặng kèm 30 checklist CRO' : ((currentLang === 'zh') ? '已售出 428 份 • 赠30步转化清单' : '428 copies sold • Includes 30-step CRO checklist'),
        url: 'shop.html'
      },
      {
        badge: 'HOT TREND',
        badgeClass: 'bg-amber-500 text-white',
        price: currentCurrency === 'VND' ? '149.000₫' : '$5.99',
        icon: 'image',
        title: (currentLang === 'vi') ? 'Bộ 25 Preset Lightroom: Cinematic Tech Minimal' : ((currentLang === 'zh') ? '25款精调Lightroom预设：科技影调大师包' : '25 Pro Lightroom Presets: Cinematic Tech Pack'),
        sub: (currentLang === 'vi') ? 'Đã bán 265 bộ • Tối ưu ảnh chụp đồ công nghệ' : ((currentLang === 'zh') ? '已售出 265 套 • 专为数码桌面调优' : '265 packs sold • Custom XMP & DNG for tech reviews'),
