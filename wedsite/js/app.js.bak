        </a>
      `;
    }).join('');

    marquees.forEach(m => {
      m.innerHTML = setHtml + setHtml;
    });

    lucide.createIcons();
  }

  renderMarquees();
  window.addEventListener('languageChanged', renderMarquees);
}

